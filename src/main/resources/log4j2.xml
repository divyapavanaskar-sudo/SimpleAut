<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <!-- ================== Properties ================== -->
    <Properties>
        <Property name="logDir">logs</Property>
        <Property name="logPattern">
            %d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %c{1} - %msg%n
        </Property>
    </Properties>

    <!-- ================== Appenders ================== -->
    <Appenders>

        <!-- ✅ Console Appender -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${logPattern}"/>
        </Console>

        <!-- ✅ Main File Logger -->
        <RollingFile name="FileAppender"
                     fileName="${logDir}/automation.log"
                     filePattern="${logDir}/automation-%d{yyyy-MM-dd}.log.gz">
            <PatternLayout pattern="${logPattern}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
            </Policies>
        </RollingFile>

        <!-- ✅ Error File Logger -->
        <RollingFile name="ErrorAppender"
                     fileName="${logDir}/error.log"
                     filePattern="${logDir}/error-%d{yyyy-MM-dd}.log.gz">
            <PatternLayout pattern="${logPattern}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
            </Policies>
            <Filters>
                <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            </Filters>
        </RollingFile>

    </Appenders>

    <!-- ================== Loggers ================== -->
    <Loggers>

        <!-- ✅ Framework logs -->
        <Logger name="utils" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>

        <!-- ✅ Selenium logs (reduce noise) -->
        <Logger name="org.openqa.selenium" level="warn"/>

        <!-- ✅ Root Logger -->
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
            <AppenderRef ref="ErrorAppender"/>
        </Root>

    </Loggers>

</Configuration>